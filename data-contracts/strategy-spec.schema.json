{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantforge.dev/contracts/v1/strategy-spec.schema.json",
  "title": "StrategySpec",
  "description": "Versioned machine-readable definition of trading rules and risk. ADR-003: this is the immutable contract between the AI layer and the deterministic engine. Blueprint \u00a710, \u00a722. Missing values are ERRORS, not defaults - no agent may invent an unresolved parameter.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "strategy_id",
    "version",
    "market",
    "timeframe",
    "direction",
    "entry",
    "exit",
    "risk"
  ],
  "properties": {
    "strategy_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$",
      "description": "Stable slug, e.g. btc-breakout"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Incremented on every rule change. A running deployment cannot change version without redeployment (\u00a724)."
    },
    "market": {
      "type": "string",
      "enum": [
        "BTC-PERP",
        "ETH-PERP"
      ],
      "description": "ADR-001 restricts internship scope to BTC/ETH perpetuals on one exchange."
    },
    "timeframe": {
      "type": "string",
      "enum": [
        "1m",
        "5m",
        "15m"
      ],
      "description": "\u00a76: intraday 1m-15m. No HFT."
    },
    "direction": {
      "type": "string",
      "enum": [
        "long",
        "short",
        "both"
      ]
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conditions",
        "execute_at"
      ],
      "properties": {
        "conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/rule"
          }
        },
        "execute_at": {
          "type": "string",
          "enum": [
            "next_bar_open",
            "current_bar_close"
          ],
          "description": "Guards look-ahead. current_bar_close is only valid when the signal uses data strictly before t."
        }
      }
    },
    "exit": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "stop_loss_pct"
          ]
        },
        {
          "required": [
            "max_holding_minutes"
          ]
        }
      ],
      "description": "At least one bounded exit is mandatory. An unbounded strategy cannot be approved.",
      "properties": {
        "stop_loss_pct": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 50
        },
        "take_profit_pct": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "max_holding_minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10080
        },
        "conditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rule"
          }
        }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "risk_per_trade_pct",
        "daily_loss_limit_pct",
        "max_open_positions"
      ],
      "description": "\u00a735 portfolio policy layer. The risk engine enforces these; an agent may propose but never override them.",
      "properties": {
        "risk_per_trade_pct": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 5
        },
        "daily_loss_limit_pct": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 20
        },
        "max_open_positions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "max_notional_usd": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "created_by": {
          "type": "string",
          "description": "agent id or user id"
        },
        "source_hypothesis": {
          "type": "string",
          "description": "The user's original natural-language idea, retained for audit."
        },
        "clarifications": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "question",
              "answer"
            ],
            "properties": {
              "question": {
                "type": "string"
              },
              "answer": {
                "type": "string"
              }
            }
          },
          "description": "\u00a79 step 1 - the questions the agent asked and what the user answered."
        }
      }
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expression"
      ],
      "description": "A single boolean condition. Only indicators in the supported allowlist may appear; the compiler rejects anything else rather than guessing.",
      "properties": {
        "expression": {
          "type": "string",
          "minLength": 1,
          "examples": [
            "close > previous_4h_high",
            "volume > 1.5 * sma(volume, 20)"
          ]
        },
        "lookback_bars": {
          "type": "integer",
          "minimum": 0,
          "description": "Declared warmup. The engine asserts no bar before index lookback_bars produces a signal."
        }
      }
    }
  }
}
