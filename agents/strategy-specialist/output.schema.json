{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantforge.dev/agents/v1/strategy-specialist.output.schema.json",
  "title": "strategy-specialist output",
  "type": "object",
  "required": [
    "kind"
  ],
  "oneOf": [
    {
      "properties": {
        "kind": {
          "const": "questions"
        },
        "questions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "kind",
        "questions"
      ]
    },
    {
      "properties": {
        "kind": {
          "const": "result"
        },
        "payload": {
          "type": "object"
        }
      },
      "required": [
        "kind",
        "payload"
      ]
    },
    {
      "properties": {
        "kind": {
          "const": "error"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "reason"
      ]
    }
  ]
}
