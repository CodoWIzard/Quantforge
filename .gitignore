# Secrets — never commit
.env
.env.*
!.env.example
*.key
*.pem
secrets/
credentials.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# Node
node_modules/
.next/
.turbo/
*.tsbuildinfo

# Data — market history belongs in Blob, not git.
# ANCHORED with a leading slash on purpose: a bare `data/` is unanchored and matches
# a directory named data at ANY depth, so it silently swallowed research/data/ — the
# whole Week 3 tool layer staged as nothing and `git commit` reported success.
/data/
*.parquet
*.csv
*.db
*.sqlite

# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example

# Bot build worktrees (services/discord-bots/builder.py)
.worktrees/

# Stray XDG dirs created when a tool runs without HOME set (gh writes
# .local/state/gh/device-id). Never project state, and one of them holds an
# identifier - keep both out of git rather than committing them by accident.
.local/
.config/
.cache/

# Artifacts
artifacts/
runs/
logs/
*.log

# OS / editor
.DS_Store
.idea/
.vscode/

# Scratch inbox — drafts dropped in for an agent to read, not repo truth
.soul-inbox/
